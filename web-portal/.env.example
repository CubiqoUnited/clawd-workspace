# Vercel Deployment
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=your_team_id_here
GITHUB_REPO=your-org/web-portal-sites

# Shopify Integration
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_token
SHOPIFY_API_VERSION=2024-01

# Printify Integration
PRINTIFY_API_KEY=your_printify_api_key
PRINTIFY_SHOP_ID=your_shop_id

# Google Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database (Optional - if using database instead of files)
# DATABASE_URL=postgresql://user:password@localhost:5432/webportal
# Or SQLite:
# DATABASE_URL=file:./data/webportal.db

# Analytics Storage
ANALYTICS_DATA_DIR=./data/analytics

# Generated Sites Storage
SITES_DATA_DIR=./data/sites

# Security
# SESSION_SECRET=your_session_secret_here
# JWT_SECRET=your_jwt_secret_here

# Email (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Webhooks (Optional)
# WEBHOOK_SECRET=your_webhook_secret
